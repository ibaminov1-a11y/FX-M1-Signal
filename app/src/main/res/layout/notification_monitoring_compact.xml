<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="64dp"
    android:background="#101126"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingLeft="6dp"
    android:paddingRight="6dp">

    <ImageView
        android:id="@+id/notifLogo"
        android:layout_width="42dp"
        android:layout_height="42dp"
        android:scaleType="centerCrop"
        android:src="@drawable/app_icon" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/notifTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:ellipsize="end"
            android:text="FX M1 Bot · WAIT"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/notifCore"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:ellipsize="end"
            android:text="EUR/USD · M1 · NORMAL · WAIT · 32/100"
            android:textColor="#DCD6EA"
            android:textSize="8sp" />

        <TextView
            android:id="@+id/notifConnection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:ellipsize="end"
            android:text="MARKET OPEN · SERVER CONNECTED · MT5 CONNECTED"
            android:textColor="#42D67A"
            android:textSize="7sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="72dp"
        android:layout_height="match_parent"
        android:layout_marginStart="4dp"
        android:gravity="center"
        android:orientation="vertical">

        <TextView
            android:id="@+id/notifPause"
            android:layout_width="match_parent"
            android:layout_height="27dp"
            android:background="#211B3A"
            android:gravity="center"
            android:text="Ⅱ  PAUSE"
            android:textColor="#B47AFF"
            android:textSize="8sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/notifEmergency"
            android:layout_width="match_parent"
            android:layout_height="27dp"
            android:layout_marginTop="2dp"
            android:background="#2A1420"
            android:gravity="center"
            android:text="■ STOP"
            android:textColor="#FF4857"
            android:textSize="8sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
