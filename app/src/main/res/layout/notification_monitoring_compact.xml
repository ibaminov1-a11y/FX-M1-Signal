<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="vertical" android:padding="8dp" android:background="#111227">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
        <ImageView android:id="@+id/notifLogo" android:layout_width="46dp" android:layout_height="46dp" android:scaleType="centerCrop" />
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:layout_marginStart="10dp">
            <TextView android:id="@+id/notifTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#FFFFFF" android:textSize="16sp" android:textStyle="bold" />
            <TextView android:id="@+id/notifCore" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#FFFFFF" android:textSize="13sp" android:maxLines="2" />
        </LinearLayout>
    </LinearLayout>
    <TextView android:id="@+id/notifAccount" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:textColor="#E6E1F5" android:textSize="12sp" />
    <TextView android:id="@+id/notifPositions" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#BDB6D1" android:textSize="12sp" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="40dp" android:orientation="horizontal" android:layout_marginTop="6dp">
        <TextView android:id="@+id/notifPause" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:text="PAUSE" android:textColor="#B47AFF" android:textStyle="bold" android:background="#211B3A" />
        <Space android:layout_width="8dp" android:layout_height="1dp" />
        <TextView android:id="@+id/notifEmergency" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:text="EMERGENCY" android:textColor="#FF4857" android:textStyle="bold" android:background="#2A1420" />
    </LinearLayout>
</LinearLayout>