<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="48dp" android:orientation="vertical" android:background="#111227">
<TextView android:id="@+id/v108_notification_text" android:layout_width="match_parent" android:layout_height="16dp" android:textColor="#F4F1FF" android:textSize="11sp" android:maxLines="1" android:ellipsize="end" android:gravity="center_vertical" />
<LinearLayout android:layout_width="match_parent" android:layout_height="32dp" android:orientation="horizontal">
<TextView android:id="@+id/v108_play" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:layout_marginStart="3dp" android:text="PLAY" android:contentDescription="PLAY" android:gravity="center" android:textColor="#F4F1FF" android:textSize="11sp" android:background="#4E2599" android:maxLines="2" />
<TextView android:id="@+id/v108_pause" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:layout_marginStart="3dp" android:text="PAUSE" android:contentDescription="PAUSE" android:gravity="center" android:textColor="#F4F1FF" android:textSize="11sp" android:background="#4E2599" android:maxLines="2" />
<TextView android:id="@+id/v108_stop" android:layout_width="0dp" android:layout_weight="1.6" android:layout_height="match_parent" android:layout_marginStart="3dp" android:text="EMERGENCY STOP" android:contentDescription="EMERGENCY STOP" android:gravity="center" android:textColor="#FF4857" android:textSize="11sp" android:background="#181430" android:maxLines="2" />
</LinearLayout></LinearLayout>
