<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="18dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="FX M1 Bot · V5.1"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="M1 вход · режимы сигнала · MT5 execution"
            android:textSize="14sp" />

        <Spinner
            android:id="@+id/symbolSpinner"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="18dp" />

        <EditText
            android:id="@+id/apiKeyInput"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="10dp"
            android:hint="Twelve Data API key"
            android:inputType="textPassword"
            android:singleLine="true" />

        <Button
            android:id="@+id/saveKeyButton"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="8dp"
            android:text="Сохранить API key" />


        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Режим сигнала"
            android:textSize="14sp" />

        <Spinner
            android:id="@+id/signalModeSpinner"
            android:layout_width="match_parent"
            android:layout_height="48dp" />

        <Button
            android:id="@+id/analyzeButton"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="16dp"
            android:text="ЗАПУСТИТЬ МОНИТОРИНГ"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/statusText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Мониторинг остановлен."
            android:textSize="15sp" />

        <TextView
            android:id="@+id/signalText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:gravity="center"
            android:text="WAIT"
            android:textSize="42sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/confidenceText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="Качество сетапа: —"
            android:textSize="17sp" />

        <TextView
            android:id="@+id/levelsText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="Entry: —&#10;SL: —&#10;TP1: —&#10;TP2: —"
            android:textSize="20sp"
            android:lineSpacingExtra="6dp" />

        <TextView
            android:id="@+id/contextText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="Контекст появится после анализа."
            android:textSize="15sp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="24dp"
            android:background="#CCCCCC" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="ТОРГОВЫЙ МОДУЛЬ"
            android:textSize="20sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/serverUrlInput"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="10dp"
            android:hint="Адрес сервера (добавим дома)"
            android:inputType="textUri"
            android:singleLine="true" />

        <Button
            android:id="@+id/serverCheckButton"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="8dp"
            android:text="ПРОВЕРИТЬ СЕРВЕР" />

        <TextView
            android:id="@+id/serverStatusText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="SERVER: NOT CONNECTED&#10;MT5: OFFLINE"
            android:textSize="16sp"
            android:textStyle="bold" />


        <TextView
            android:id="@+id/priceCompareText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="API Price: —&#10;MT5 Bid/Ask: — / —&#10;Разница: —&#10;EXECUTION PRICE: MT5"
            android:textSize="15sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="Макс. отклонение MT5 от сигнала"
            android:textSize="14sp" />

        <Spinner
            android:id="@+id/maxDriftSpinner"
            android:layout_width="match_parent"
            android:layout_height="48dp" />

        <TextView
            android:id="@+id/accountText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="Счёт: —&#10;Баланс: —&#10;Equity: —"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/positionsText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Открытые позиции: —&#10;Текущий P/L: —"
            android:textSize="16sp" />

        <Switch
            android:id="@+id/autoTradingSwitch"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="14dp"
            android:text="AUTO TRADING · DEMO ONLY"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="Риск на сделку"
            android:textSize="14sp" />

        <Spinner
            android:id="@+id/riskSpinner"
            android:layout_width="match_parent"
            android:layout_height="48dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Максимум открытых позиций"
            android:textSize="14sp" />

        <Spinner
            android:id="@+id/maxPositionsSpinner"
            android:layout_width="match_parent"
            android:layout_height="48dp" />

        <Button
            android:id="@+id/closeAllButton"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="12dp"
            android:enabled="false"
            android:text="ЗАКРЫТЬ ВСЕ ПОЗИЦИИ" />

        <Button
            android:id="@+id/emergencyStopButton"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:layout_marginTop="10dp"
            android:text="EMERGENCY STOP"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="ЖУРНАЛ"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/journalText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Журнал пока пуст."
            android:textSize="14sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:text="V5.1: сигнал формируется по выбранному режиму. Исполнение после подключения сервера проверяется по котировке MT5 DEMO, а не по цене Twelve Data."
            android:textSize="13sp" />

    </LinearLayout>
</ScrollView>
