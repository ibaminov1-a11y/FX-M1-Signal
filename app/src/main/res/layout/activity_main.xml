<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="18dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="FX M1 Signal"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="M1 вход · H1/M15/M5 фильтр"
            android:textSize="14sp" />

        <Spinner
            android:id="@+id/symbolSpinner"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="18dp" />

        <EditText
            android:id="@+id/apiKeyInput"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="10dp"
            android:hint="Twelve Data API key"
            android:inputType="textPassword"
            android:singleLine="true" />

        <Button
            android:id="@+id/saveKeyButton"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="8dp"
            android:text="Сохранить API key" />

        <Button
            android:id="@+id/analyzeButton"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="16dp"
            android:text="АНАЛИЗИРОВАТЬ СЕЙЧАС"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/statusText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Выберите инструмент и нажмите анализ."
            android:textSize="15sp" />

        <TextView
            android:id="@+id/signalText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:gravity="center"
            android:text="WAIT"
            android:textSize="42sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/confidenceText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="Уверенность модели: —"
            android:textSize="17sp" />

        <TextView
            android:id="@+id/levelsText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="Entry: —&#10;SL: —&#10;TP1: —&#10;TP2: —"
            android:textSize="20sp"
            android:lineSpacingExtra="6dp" />

        <TextView
            android:id="@+id/contextText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="Контекст появится после анализа."
            android:textSize="15sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:text="Важно: это вероятностный технический сигнал, а не гарантия движения цены. Сначала проверяйте на демо-счёте."
            android:textSize="13sp" />

    </LinearLayout>
</ScrollView>