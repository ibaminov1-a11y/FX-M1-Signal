<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="48dp" android:orientation="vertical" android:background="@drawable/v11_notification_surface" android:paddingLeft="6dp" android:paddingRight="6dp">
    <TextView android:id="@+id/n_status" android:layout_width="match_parent" android:layout_height="18dp" android:textSize="11sp" android:maxLines="1" android:ellipsize="end" style="@android:style/TextAppearance.Material.Notification" android:textColor="#D1B8FF" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="30dp" android:orientation="horizontal">
        <TextView android:id="@+id/n_play" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:gravity="center" android:text="PLAY" android:contentDescription="PLAY" android:textSize="12sp" android:textStyle="bold" style="@android:style/TextAppearance.Material.Notification" android:textColor="#F4F1FF" android:background="@drawable/v11_notification_button" />
        <TextView android:id="@+id/n_pause" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:layout_marginLeft="4dp" android:gravity="center" android:text="PAUSE" android:contentDescription="PAUSE" android:textSize="12sp" android:textStyle="bold" style="@android:style/TextAppearance.Material.Notification" android:textColor="#F4F1FF" android:background="@drawable/v11_notification_button" />
        <TextView android:id="@+id/n_stop" android:layout_width="0dp" android:layout_weight="1.7" android:layout_height="match_parent" android:layout_marginLeft="4dp" android:gravity="center" android:text="EMERGENCY STOP" android:contentDescription="EMERGENCY STOP" android:textSize="11sp" android:textColor="#FF4857" android:textStyle="bold" android:background="@drawable/v11_notification_stop" />
    </LinearLayout>
</LinearLayout>
