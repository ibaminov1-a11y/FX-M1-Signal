<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="#111227"
    android:orientation="vertical"
    android:padding="8dp">

    <LinearLayout android:layout_width="match_parent" android:layout_height="42dp" android:gravity="center_vertical" android:orientation="horizontal">
        <ImageView android:id="@+id/notifLogo" android:layout_width="40dp" android:layout_height="40dp" android:scaleType="centerCrop" android:src="@drawable/app_icon" />
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:layout_weight="1" android:orientation="vertical">
            <TextView android:id="@+id/notifTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="FX M1 Bot · WAIT" android:textColor="#FFFFFF" android:textSize="14sp" android:textStyle="bold" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="MONITORING" android:textColor="#A66BFF" android:textSize="10sp" android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <TextView android:id="@+id/notifCore" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:maxLines="1" android:ellipsize="end" android:text="EUR/USD · M1 · NORMAL · WAIT · 32/100" android:textColor="#F5F2FB" android:textSize="11sp" android:textStyle="bold" />
    <ProgressBar android:id="@+id/notifQualityBar" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="4dp" android:layout_marginTop="3dp" android:max="100" android:progress="32" android:progressTint="#A66BFF" android:progressBackgroundTint="#343548" />

    <LinearLayout android:layout_width="match_parent" android:layout_height="82dp" android:layout_marginTop="6dp" android:orientation="horizontal">
        <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:orientation="vertical">
            <TextView android:id="@+id/notifAccount" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Баланс (DEMO)\n—" android:textColor="#F5F2FB" android:textSize="10sp" />
            <TextView android:id="@+id/notifPositions" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:text="Открытые позиции\n0" android:textColor="#F5F2FB" android:textSize="10sp" />
            <TextView android:id="@+id/notifRisk" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:text="Риск\n0.50% · AUTO OFF" android:textColor="#F5F2FB" android:textSize="10sp" />
        </LinearLayout>
        <View android:layout_width="1dp" android:layout_height="match_parent" android:layout_marginStart="6dp" android:layout_marginEnd="6dp" android:background="#37304F" />
        <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:orientation="vertical">
            <TextView android:id="@+id/notifQuality" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Качество\n32/100" android:textColor="#A66BFF" android:textSize="10sp" android:textStyle="bold" />
            <TextView android:id="@+id/notifApiPrice" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:text="API Price\n—" android:textColor="#F5F2FB" android:textSize="10sp" />
            <TextView android:id="@+id/notifLastSignal" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:text="Последний анализ\n—" android:textColor="#F5F2FB" android:textSize="10sp" />
        </LinearLayout>
    </LinearLayout>

    <TextView android:id="@+id/notifConnection" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:gravity="center" android:maxLines="1" android:ellipsize="end" android:text="MARKET OPEN · SERVER CONNECTED · MT5 CONNECTED" android:textColor="#42D67A" android:textSize="9sp" android:textStyle="bold" />
    <TextView android:id="@+id/notifSmart" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:gravity="center" android:maxLines="1" android:ellipsize="end" android:text="Risk ON · BE ON · Trail ON · ASIA" android:textColor="#B47AFF" android:textSize="8sp" />

    <LinearLayout android:layout_width="match_parent" android:layout_height="36dp" android:layout_marginTop="5dp" android:orientation="horizontal">
        <TextView android:id="@+id/notifPause" android:layout_width="0dp" android:layout_height="match_parent" android:layout_marginEnd="3dp" android:layout_weight="1" android:background="#211B3A" android:gravity="center" android:text="Ⅱ  PAUSE" android:textColor="#B47AFF" android:textSize="10sp" android:textStyle="bold" />
        <TextView android:id="@+id/notifEmergency" android:layout_width="0dp" android:layout_height="match_parent" android:layout_marginStart="3dp" android:layout_weight="1" android:background="#2A1420" android:gravity="center" android:text="■  EMERGENCY STOP" android:textColor="#FF4857" android:textSize="10sp" android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
