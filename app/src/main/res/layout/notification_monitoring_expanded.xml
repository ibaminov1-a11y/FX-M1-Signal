<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="#111227"
    android:orientation="vertical"
    android:padding="10dp">

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
        <ImageView android:id="@+id/notifLogo" android:layout_width="54dp" android:layout_height="54dp" android:scaleType="centerCrop" android:src="@drawable/app_icon" />
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="10dp" android:layout_weight="1" android:orientation="vertical">
            <TextView android:id="@+id/notifTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="FX M1 Bot" android:textColor="#FFFFFF" android:textSize="16sp" android:textStyle="bold" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="MONITORING" android:textColor="#A66BFF" android:textSize="13sp" android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <TextView android:id="@+id/notifCore" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="7dp" android:text="EUR/USD · M1 · NORMAL · WAIT · 32/100" android:textColor="#F5F2FB" android:textSize="13sp" android:textStyle="bold" />
    <ProgressBar android:id="@+id/notifQualityBar" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="6dp" android:layout_marginTop="5dp" android:max="100" android:progress="32" android:progressTint="#A66BFF" android:progressBackgroundTint="#343548" />

    <View android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginTop="7dp" android:layout_marginBottom="7dp" android:background="#37304F" />

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
            <TextView android:id="@+id/notifAccount" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Баланс (DEMO)\n—" android:textColor="#F5F2FB" android:textSize="12sp" />
            <TextView android:id="@+id/notifPositions" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="7dp" android:text="Открытые позиции\n0" android:textColor="#F5F2FB" android:textSize="12sp" />
            <TextView android:id="@+id/notifRisk" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="7dp" android:text="Риск на сделку\n0.50%" android:textColor="#F5F2FB" android:textSize="12sp" />
        </LinearLayout>
        <View android:layout_width="1dp" android:layout_height="112dp" android:layout_marginStart="8dp" android:layout_marginEnd="8dp" android:background="#37304F" />
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
            <TextView android:id="@+id/notifQuality" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Качество сигнала\n32/100" android:textColor="#A66BFF" android:textSize="12sp" android:textStyle="bold" />
            <TextView android:id="@+id/notifApiPrice" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="7dp" android:text="API Price\n—" android:textColor="#F5F2FB" android:textSize="12sp" />
            <TextView android:id="@+id/notifLastSignal" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="7dp" android:text="Последний анализ\n—" android:textColor="#F5F2FB" android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>

    <TextView android:id="@+id/notifConnection" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="7dp" android:gravity="center" android:text="MARKET CLOSED · SERVER CONNECTED · MT5 CONNECTED" android:textColor="#42D67A" android:textSize="10sp" />

    <LinearLayout android:layout_width="match_parent" android:layout_height="42dp" android:layout_marginTop="8dp" android:orientation="horizontal">
        <TextView android:id="@+id/notifPause" android:layout_width="0dp" android:layout_height="match_parent" android:layout_marginEnd="4dp" android:layout_weight="1" android:background="#211B3A" android:gravity="center" android:text="Ⅱ  PAUSE" android:textColor="#B47AFF" android:textSize="11sp" android:textStyle="bold" />
        <TextView android:id="@+id/notifEmergency" android:layout_width="0dp" android:layout_height="match_parent" android:layout_marginStart="4dp" android:layout_weight="1" android:background="#2A1420" android:gravity="center" android:text="■  EMERGENCY STOP" android:textColor="#FF4857" android:textSize="11sp" android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
