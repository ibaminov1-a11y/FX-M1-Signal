<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="#111227" android:padding="4dp">
<TextView android:id="@+id/notifCore" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="13sp" android:textColor="#B0AAC7" android:maxLines="1" android:ellipsize="end" android:paddingBottom="4dp" />
<TextView android:id="@+id/notifConnection" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="12sp" android:textColor="#F4F1FF" android:maxLines="3" android:ellipsize="end" android:paddingBottom="8dp" />
<LinearLayout android:layout_width="match_parent" android:layout_height="44dp" android:orientation="horizontal" android:gravity="center_vertical">
<TextView android:id="@+id/notifPlay" android:layout_width="0dp" android:layout_height="40dp" android:layout_weight="1" android:gravity="center" android:text="PLAY" android:textColor="#F4F1FF" android:background="#4E2599" android:textSize="12sp" android:textStyle="bold" />
<TextView android:id="@+id/notifPause" android:layout_width="0dp" android:layout_height="40dp" android:layout_weight="1" android:layout_marginStart="4dp" android:gravity="center" android:text="PAUSE" android:textColor="#F4F1FF" android:background="#281B48" android:textSize="12sp" android:textStyle="bold" />
<TextView android:id="@+id/notifEmergency" android:layout_width="0dp" android:layout_height="40dp" android:layout_weight="1.6" android:layout_marginStart="4dp" android:gravity="center" android:text="EMERGENCY STOP" android:textColor="#FF4857" android:background="#2A1420" android:textSize="10sp" android:textStyle="bold" />
</LinearLayout>
</LinearLayout>
